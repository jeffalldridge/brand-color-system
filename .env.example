# Optional environment overrides for site URL configuration.
# Defaults match the public deploy at https://jeffalldridge.github.io/brand-color-system/
#
# Set these only for fork / preview / staging deploys.

# Origin (no path). Default: https://jeffalldridge.github.io
# NEXT_PUBLIC_SITE_URL=https://example.com

# Path prefix where the site is served. Default: /brand-color-system
# Set to empty string ("") if you serve from a domain root.
# NEXT_PUBLIC_BASE_PATH=/your-fork
